#!/usr/bin/env python3
"""Fake rdt: logs argv, prints fixture. Tests prepend this dir to PATH."""
import json
import os
import sys

log = os.environ.get("RDT_ARGV_LOG", "")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps(sys.argv[1:], ensure_ascii=False) + "\n")

argv = sys.argv[1:]
# RDT_REJECT_FLAGS=--json,--yaml makes the shim reject those flags with
# exit 2 (mimics backend "No such option"), so tests can lock tidy flag
# stripping/passthrough contracts for commands without structured output.
reject = {f.strip() for f in os.environ.get("RDT_REJECT_FLAGS", "").split(",") if f.strip()}
if reject:
    for tok in argv:
        base = tok.split("=", 1)[0]
        if base in reject:
            print(f"Error: No such option '{base}'.", file=sys.stderr)
            raise SystemExit(2)
if argv and argv[0] == "export":
    # RDT_EXPORT_SKIP=1 simulates a backend that exits 0 without writing
    # the file (stdout used / flag ignored) for the missing-file guard test.
    if os.environ.get("RDT_EXPORT_SKIP") == "1":
        raise SystemExit(0)
    out = None
    fmt = "csv"
    options = argv[:argv.index("--")] if "--" in argv else argv
    for i, t in enumerate(options):
        base = t.split("=", 1)[0] if t.startswith("--") else t
        value = t.split("=", 1)[1] if "=" in t and t.startswith("--") else (options[i + 1] if i + 1 < len(options) else None)
        if base in ("-o", "--output"):
            out = value
        elif base == "--format":
            fmt = value
        elif t.startswith("-o") and len(t) > 2:
            out = t[2:].lstrip("=")
    text = os.environ.get("RDT_EXPORT_JSON", "[]") if fmt == "json" else os.environ.get("RDT_EXPORT_CSV", "")
    if out:
        with open(out, "w", encoding="utf-8", newline="") as f:
            f.write(text)
    raise SystemExit(0)

fix = os.environ.get("RDT_FIXTURE", "")
with open(fix, encoding="utf-8") as f:
    sys.stdout.write(f.read())
serr = os.environ.get("RDT_STDERR", "")
if serr:
    sys.stderr.write(serr)
raise SystemExit(int(os.environ.get("RDT_EXIT", "0") or 0))
