#!/usr/bin/env python3
"""Sahte rdt: argv'yi loglar, fixture basar. Testler PATH'e bu dizini koyar."""
import json
import os
import sys

log = os.environ.get("RDT_ARGV_LOG", "")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps(sys.argv[1:], ensure_ascii=False) + "\n")

argv = sys.argv[1:]
if argv and argv[0] == "export":
    out = None
    for i, t in enumerate(argv):
        base = t.split("=", 1)[0] if t.startswith("--") else t
        if base in ("-o", "--output"):
            out = t.split("=", 1)[1] if "=" in t and t.startswith("--") else (argv[i + 1] if i + 1 < len(argv) else None)
    csv_text = os.environ.get("RDT_EXPORT_CSV", "")
    if out:
        with open(out, "w", encoding="utf-8", newline="") as f:
            f.write(csv_text)
    print("", end="")
    raise SystemExit(0)

fix = os.environ.get("RDT_FIXTURE", "")
with open(fix, encoding="utf-8") as f:
    sys.stdout.write(f.read())
raise SystemExit(int(os.environ.get("RDT_EXIT", "0") or 0))
